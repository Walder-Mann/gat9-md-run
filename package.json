{
  "name": "markdown-runner",
  "displayName": "Markdown Runner",
  "version": "0.0.2",
  "publisher": "gat",
  "author": "Walder-Mann",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Walder-Mann/gat9-md-run.git"
  },
  "categories": [
    "Other"
  ],
  "publishConfig": {
    "access": "public"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:markdown.preview",
    "onUri"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**/*.js",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "contributes": {
    "configuration": {
      "title": "Markdown Runner",
      "properties": {
        "markdown-runner.powershell.enableInitCommand": {
          "type": "boolean",
          "default": true,
          "description": "Включить инициализацию перед запуском скрипта PowerShell."
        },
        "markdown-runner.powershell.initCommand": {
          "type": "string",
          "default": "chcp 65001 > $null; $env:WSL_UTF8=1; $OutputEncoding = [Console]::InputEncoding = [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new();",
          "description": "Команда инициализации окружения PowerShell."
        },
        "markdown-runner.powershell.enableInitScripts": {
          "type": "boolean",
          "default": true,
          "description": "Выполнять автоматический поиск и подмешивание блоков 'powershell init-script', находящихся выше исполняемого кода."
        }
      }
    },
    "commands": [
      {
        "command": "markdown-runner.runCodeInternal",
        "title": "Run Code Block"
      }
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "vscode:prepublish": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "esbuild-compile": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "esbuild-watch": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "license-checker": "^25.0.1",
    "typescript": "^5.0.0"
  },
  "description": "Интерактивная среда выполнения PowerShell-скриптов прямо из стандартного встроенного средства предпросмотра **VS Code Markdown Preview** (`Ctrl + Shift + V`).",
  "dependencies": {
    "@types/vscode": "^1.80.0"
  },
  "keywords": [],
  "type": "commonjs"
}